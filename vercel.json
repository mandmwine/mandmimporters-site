{
  "rewrites": [
    { "source": "/images/:file", "destination": "/images/images/:file" }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/understanding-winw",
      "destination": "/wineculture",
      "permanent": true
    },
    {
      "source": "/tasting-wine",
      "destination": "/wineculture",
      "permanent": true
    },
    {
      "source": "/conservation-and-cellaring",
      "destination": "/wineculture",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/course-welcome",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/course-welcome/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/workshop",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/work-with-me",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/new-page",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/articles",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wine-lexicon",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cart",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
