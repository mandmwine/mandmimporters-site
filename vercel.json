      "permanent": false
    },
    {
      "source": "/wines/p/botteotto-cerasuolo-dabruzzo-rose",
      "destination": "/wines",
      "permanent": false
    },
    {
      "source": "/wines/p/botteotto-grigio-xm6p7-w95x6",
      "destination": "/wines",
      "permanent": false
    },
    {
      "source": "/wines/p/botteotto-grigio-xm6p7",
      "destination": "/wines",
      "permanent": false
    },
    {
      "source": "/wines/p/botteotto-montepulciano-dabruzzo",
      "destination": "/wines",
      "permanent": false
    },
    {
      "source": "/wines/p/botteotto-moscato",
      "destination": "/wines",
      "permanent": false
    },
    {
      "source": "/wines/p/chateau-valandraud-virginie-de-valandraud",
      "destination": "/wines",
      "permanent": false
    },
    {
      "source": "/wines/p/falesco-ferentano",
      "destination": "/wines",
      "permanent": false
    },
    {
      "source": "/wines/p/janisson-and-fils-grand-cru-brut",
      "destination": "/wines",
      "permanent": false
    },
    {
      "source": "/wines/p/janisson-fils-brut-ros",
      "destination": "/wines",
      "permanent": false
    },
    {
      "source": "/wines/p/san-paolo-irpinia-aglianico",
      "destination": "/wines",
      "permanent": false
    },
    {
      "source": "/wines/p/von-hvel-oberemmeler-riesling",
      "destination": "/wines",
      "permanent": false
    },
    {
      "source": "/wines/p/von-hvel-saar-riesling-feinherb",
      "destination": "/wines",
      "permanent": false
    },
    {
      "source": "/wines/p/von-hvel-scharzhofberg-riesling",
      "destination": "/wines",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/articles/pdf/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}