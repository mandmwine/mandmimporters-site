{
  "rewrites": [
    {
      "source": "/catalog-admin",
      "destination": "https://mandm-catalog.vercel.app/catalog-admin"
    },
    {
      "source": "/catalog-admin/:path*",
      "destination": "https://mandm-catalog.vercel.app/catalog-admin/:path*"
    },
    {
      "source": "/images/bottles/:file",
      "destination": "/images/images/:file"
    },
    {
      "source": "/images/:file",
      "destination": "/images/images/:file"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/understanding-winw",
      "destination": "/wineculture",
      "permanent": true
    },
    {
      "source": "/conservation-and-cellaring",
      "destination": "/wineculture",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/course-welcome",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/course-welcome/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/workshop",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/work-with-me",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/new-page",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wine-lexicon",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cart",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tasting-wine",
      "destination": "/wineculture#tasting-the-wine",
      "permanent": true
    },
    {
      "source": "/wine-doctor",
      "destination": "/the-wine-doctor",
      "permanent": true
    },
    {
      "source": "/kosher",
      "destination": "/learn/kosher-wine",
      "permanent": true
    },
    {
      "source": "/wines/italian",
      "destination": "/wines?country=Italy",
      "permanent": true
    },
    {
      "source": "/wines/french",
      "destination": "/wines?country=France",
      "permanent": true
    },
    {
      "source": "/wines/german",
      "destination": "/wines?country=Germany",
      "permanent": true
    },
    {
      "source": "/wines/burgundy",
      "destination": "/wines?q=burgundy",
      "permanent": true
    },
    {
      "source": "/wines/champagne",
      "destination": "/wines?color=Sparkling",
      "permanent": true
    },
    {
      "source": "/wines/rose",
      "destination": "/wines?color=Ros%C3%A9",
      "permanent": true
    },
    {
      "source": "/wines/white",
      "destination": "/wines?color=White",
      "permanent": true
    },
    {
      "source": "/wines/p/aegerter-corton-vergennes",
      "destination": "/wines",
      "permanent": false
    },
    {
      "source": "/wines/p/aegerter-nuits-saint-georges",
