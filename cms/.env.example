# --- Firebase web app (safe to expose; from Firebase console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Server secrets (Vercel > Settings > Environment Variables; never commit)
# Full service-account JSON (or the same JSON base64-encoded)
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Database: either a direct URL...
DATABASE_URL=
# ...or Cloud SQL via the connector
CLOUD_SQL_INSTANCE=project-id:us-east4:instance-name
DB_USER=postgres
DB_PASSWORD=
DB_NAME=catalog
# DB_AUTH=IAM   # optional: IAM database auth instead of a password

# --- First admin: this email becomes Admin on first sign-in when no users exist yet
BOOTSTRAP_ADMIN_EMAIL=
